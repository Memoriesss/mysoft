# 复制为 .env 并填入你的真实 key
# 所有变量必须以 VITE_ 开头才能在前端代码里读到

# ====== LLM 配置（必填） ======
# 阶跃星辰 StepFun —— OpenAI 兼容协议
# 控制台: https://platform.stepfun.com/
VITE_LLM_BASE_URL=https://api.stepfun.com/v1
# 你的 API Key
VITE_LLM_KEY=
# 模型名（按平台支持的填）
#  - step-2-16k        推荐，16000 上下文，中文能力强
#  - step-2-8k         8000 上下文，更快
#  - step-1v-8k        多模态（暂时用不到）
VITE_LLM_MODEL=step-2-16k
