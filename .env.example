# 复制为 .env 并填入你的真实 key
# 所有变量必须以 VITE_ 开头才能在前端代码里读到

# ====== LLM 配置（必填） ======
# MiniMax M3 —— Anthropic 协议
# 文档：https://platform.minimaxi.com/docs/token-plan/quickstart
# 拿 Key：https://platform.minimaxi.com/user-center/payment/token-plan
VITE_LLM_BASE_URL=https://api.minimaxi.com/anthropic
# 你的订阅 Key
VITE_LLM_KEY=
# 模型名
VITE_LLM_MODEL=MiniMax-M3
